{
  "name": "nft-marketplace",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b",
    "lint": "oxlint",
    "test:e2e": "playwright test",
    "test:e2e:update": "playwright test --update-snapshots",
    "test:visual:docker": "node scripts/visual-docker.mjs",
    "test:visual:docker:update": "node scripts/visual-docker.mjs --update",
    "lighthouse": "npm run build && npm run lighthouse:mobile && npm run lighthouse:desktop && npm run lighthouse:summary",
    "lighthouse:mobile": "lhci autorun --config=lighthouse/lighthouserc.mobile.json",
    "lighthouse:desktop": "lhci autorun --config=lighthouse/lighthouserc.desktop.json",
    "lighthouse:summary": "node scripts/lighthouse-summary.mjs",
    "figma:sync": "node --env-file=.env scripts/figma-sync.mjs"
  },
  "dependencies": {
    "@fontsource-variable/roboto-mono": "^5.3.0",
    "@hookform/resolvers": "^6.0.2",
    "@mswjs/socket.io-binding": "^0.2.0",
    "@tanstack/react-query": "^5.105.0",
    "@tanstack/react-router": "^1.170.46",
    "axios": "^1.21.0",
    "big.js": "^7.0.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.64.0",
    "msw": "^2.15.0",
    "radix-ui": "^1.8.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-hook-form": "^7.91.0",
    "socket.io-client": "^4.8.4",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.7.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@lhci/cli": "^0.15.1",
    "@playwright/test": "^1.64.1",
    "@tailwindcss/vite": "^4.3.3",
    "@tanstack/router-plugin": "^1.168.48",
    "@types/big.js": "^7.0.0",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "oxlint": "^1.89.0",
    "tailwindcss": "^4.3.3",
    "typescript": "~7.0.2",
    "vite": "^8.3.5",
    "vite-plugin-svgr": "^5.2.0"
  },
  "msw": {
    "workerDirectory": [
      "public"
    ]
  }
}
