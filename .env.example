# Ativa a camada MSW (REST + Socket.IO). Padrão: true — inclusive no build de demonstração.
VITE_ENABLE_MOCKS=true

# Base das chamadas REST (Axios).
VITE_API_URL=/api

# Origem do servidor Socket.IO. Vazio = mesma origem da aplicação.
VITE_SOCKET_URL=

# Token pessoal do Figma (somente leitura), usado apenas por `npm run figma:sync`.
# Sem prefixo VITE_ para nunca ser embutido no bundle.
FIGMA_TOKEN=
